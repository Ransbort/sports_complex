{
 "doctype": "DocType",
 "name": "Facility Booking",
 "module": "Sports Complex",
 "custom": 0,
 "istable": 0,
 "issingle": 0,
 "is_submittable": 1,
 "editable_grid": 1,
 "engine": "InnoDB",
 "autoname": "naming_series:",
 "naming_rule": "By \"Naming Series\" field",
 "sort_field": "modified",
 "sort_order": "DESC",
 "track_changes": 1,
 "field_order": [
  "naming_series",
  "customer",
  "court",
  "column_break_1",
  "booking_date",
  "start_time",
  "end_time",
  "duration",
  "section_break_1",
  "rate",
  "total_amount",
  "column_break_2",
  "booking_status",
  "payment_status",
  "sales_invoice",
  "amended_from"
 ],
 "fields": [
  {
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "options": "FB-.YYYY.-",
   "label": "Series",
   "reqd": 1
  },
  {
   "fieldname": "customer",
   "fieldtype": "Link",
   "options": "Customer",
   "label": "Customer",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "Member's linked Customer record"
  },
  {
   "fieldname": "court",
   "fieldtype": "Link",
   "options": "Court",
   "label": "Court",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "booking_date",
   "fieldtype": "Date",
   "label": "Booking Date",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "start_time",
   "fieldtype": "Time",
   "label": "Start Time",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "end_time",
   "fieldtype": "Time",
   "label": "End Time",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "duration",
   "fieldtype": "Int",
   "label": "Duration (min)",
   "read_only": 1,
   "description": "Auto-calculated from Start Time / End Time"
  },
  {
   "fieldname": "section_break_1",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "rate",
   "fieldtype": "Currency",
   "label": "Rate (per hour)"
  },
  {
   "fieldname": "total_amount",
   "fieldtype": "Currency",
   "label": "Total Amount",
   "read_only": 1
  },
  {
   "fieldname": "column_break_2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "booking_status",
   "fieldtype": "Select",
   "options": "Draft\nPayment Pending\nConfirmed\nChecked-In\nCompleted\nCancelled\nNo-show",
   "default": "Draft",
   "label": "Booking Status",
   "read_only": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "payment_status",
   "fieldtype": "Select",
   "options": "Unpaid\nPartially Paid\nPaid",
   "default": "Unpaid",
   "label": "Payment Status",
   "read_only": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "sales_invoice",
   "fieldtype": "Link",
   "options": "Sales Invoice",
   "label": "Sales Invoice",
   "read_only": 1,
   "no_copy": 1
  },
  {
   "fieldname": "amended_from",
   "fieldtype": "Link",
   "options": "Facility Booking",
   "label": "Amended From",
   "read_only": 1,
   "no_copy": 1,
   "print_hide": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "print": 1,
   "email": 1,
   "export": 1,
   "share": 1,
   "report": 1
  },
  {
   "role": "Sports Complex Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "print": 1,
   "email": 1,
   "export": 1,
   "report": 1
  },
  {
   "role": "Sports Complex Staff",
   "read": 1,
   "write": 1,
   "create": 1,
   "submit": 1,
   "print": 1,
   "report": 1
  }
 ]
}
