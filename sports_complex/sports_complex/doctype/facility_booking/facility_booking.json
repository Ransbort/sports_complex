{
 "doctype": "DocType",
 "name": "Facility Booking",
 "module": "Sports Complex",
 "custom": 0,
 "istable": 0,
 "issingle": 0,
 "is_submittable": 1,
 "editable_grid": 1,
 "engine": "InnoDB",
 "autoname": "naming_series:",
 "naming_rule": "By \"Naming Series\" field",
 "sort_field": "modified",
 "sort_order": "DESC",
 "track_changes": 1,
 "field_order": [
  "naming_series",
  "customer",
  "guest_name",
  "email",
  "phone",
  "court",
  "column_break_1",
  "booking_date",
  "start_time",
  "end_time",
  "duration",
  "section_break_1",
  "rate",
  "total_amount",
  "column_break_2",
  "booking_status",
  "payment_status",
  "no_show_penalty_amount",
  "sales_invoice",
  "google_calendar_event",
  "reminder_sent",
  "notes",
  "amended_from"
 ],
 "fields": [
  {
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "options": "FB-.YYYY.-",
   "label": "Series",
   "reqd": 1
  },
  {
   "fieldname": "customer",
   "fieldtype": "Link",
   "options": "Customer",
   "label": "Customer",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "Member's linked Customer record"
  },
  {
   "fieldname": "guest_name",
   "fieldtype": "Data",
   "label": "Guest Name",
   "in_list_view": 1,
   "description": "Name typed for this specific booking - independent of the linked Customer's own name, which only reflects whichever name was typed the first time this email ever booked. Useful when one email is shared by more than one person."
  },
  {
   "fieldname": "email",
   "fieldtype": "Data",
   "options": "Email",
   "label": "Email",
   "description": "Captured from the customer/guest at the time of booking."
  },
  {
   "fieldname": "phone",
   "fieldtype": "Data",
   "options": "Phone",
   "label": "Phone",
   "description": "Captured from the customer/guest at the time of booking. May be blank if not provided."
  },
  {
   "fieldname": "court",
   "fieldtype": "Link",
   "options": "Sports Facility",
   "label": "Facility",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "Field name kept as \"court\" for backward compatibility with existing data - it now links to Sports Facility, not the retired Court doctype."
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "booking_date",
   "fieldtype": "Date",
   "label": "Booking Date",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "start_time",
   "fieldtype": "Time",
   "label": "Start Time",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "end_time",
   "fieldtype": "Time",
   "label": "End Time",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "duration",
   "fieldtype": "Int",
   "label": "Duration (min)",
   "read_only": 1,
   "description": "Auto-calculated from Start Time / End Time"
  },
  {
   "fieldname": "section_break_1",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "rate",
   "fieldtype": "Currency",
   "label": "Rate (per hour)"
  },
  {
   "fieldname": "total_amount",
   "fieldtype": "Currency",
   "label": "Total Amount",
   "read_only": 1
  },
  {
   "fieldname": "column_break_2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "booking_status",
   "fieldtype": "Select",
   "options": "Draft\nPayment Pending\nConfirmed\nChecked-In\nCompleted\nCancelled\nNo-show",
   "default": "Draft",
   "label": "Booking Status",
   "read_only": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "payment_status",
   "fieldtype": "Select",
   "options": "Unpaid\nPartially Paid\nPaid",
   "default": "Unpaid",
   "label": "Payment Status",
   "read_only": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "no_show_penalty_amount",
   "fieldtype": "Currency",
   "label": "No-Show Penalty Amount",
   "read_only": 1,
   "no_copy": 1,
   "depends_on": "eval:doc.booking_status==\"No-show\"",
   "description": "Sports Complex Setup > No Show Penalty % of Total Amount, computed and recorded here when this booking was auto-marked No-show (see facility_booking.mark_no_shows()) - the guest already paid Total Amount in full to reach Confirmed, so this is the portion the business keeps unless a refund is later raised; it doesn't create or move any invoice on its own."
  },
  {
   "fieldname": "sales_invoice",
   "fieldtype": "Link",
   "options": "Sales Invoice",
   "label": "Sales Invoice",
   "read_only": 1,
   "no_copy": 1
  },
  {
   "fieldname": "google_calendar_event",
   "fieldtype": "Link",
   "options": "Event",
   "label": "Google Calendar Event",
   "read_only": 1,
   "no_copy": 1,
   "hidden": 1,
   "description": "Set automatically once this booking is Confirmed - see utils/google_calendar_sync.py. Configure the target calendar on Sports Complex Setup > Integrations."
  },
  {
   "fieldname": "reminder_sent",
   "fieldtype": "Check",
   "label": "Reminder Sent",
   "read_only": 1,
   "no_copy": 1,
   "hidden": 1,
   "description": "Set once facility_booking.send_booking_reminders() has emailed this booking's Send Booking Reminder notice, so the same booking isn't reminded twice."
  },
  {
   "fieldname": "notes",
   "fieldtype": "Small Text",
   "label": "Notes",
   "description": "Any special requests or information provided by the guest/customer at the time of booking."
  },
  {
   "fieldname": "amended_from",
   "fieldtype": "Link",
   "options": "Facility Booking",
   "label": "Amended From",
   "read_only": 1,
   "no_copy": 1,
   "print_hide": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "print": 1,
   "email": 1,
   "export": 1,
   "share": 1,
   "report": 1
  },
  {
   "role": "Sports Complex Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "print": 1,
   "email": 1,
   "export": 1,
   "report": 1
  },
  {
   "role": "Sports Complex Staff",
   "read": 1,
   "write": 1,
   "create": 1,
   "submit": 1,
   "print": 1,
   "report": 1
  }
 ]
}
