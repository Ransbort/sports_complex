  {
   "fieldname": "issue_date",
   "fieldtype": "Date",
   "label": "Issue Date",
   "default": "Today",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "expected_return_date",
   "fieldtype": "Date",
   "label": "Expected Return Date"
