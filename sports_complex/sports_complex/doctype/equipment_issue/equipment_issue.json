  {
   "fieldname": "issued_to_coach",
   "fieldtype": "Link",
   "label": "Coach",
   "options": "Coach",
   "depends_on": "eval:doc.issued_to_type=='Coach'"
  },
  {
   "fieldname": "issued_to_team",
   "fieldtype": "Link",
   "label": "Team",
   "options": "Team",
   "depends_on": "eval:doc.issued_to_type=='Team'"
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break",
   "label": ""
