{
 "doctype": "DocType",
 "name": "Maintenance Schedule",
 "module": "Sports Complex",
 "custom": 0,
 "istable": 0,
 "issingle": 0,
 "autoname": "naming_series:",
 "naming_rule": "By \"Naming Series\" field",
 "sort_field": "scheduled_date",
 "sort_order": "DESC",
 "track_changes": 1,
 "is_submittable": 0,
 "fields": [
  {
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "options": "MAINT-.YYYY.-",
   "label": "Series",
   "default": "MAINT-.YYYY.-"
  },
  {
   "fieldname": "court",
   "fieldtype": "Link",
   "options": "Court",
   "label": "Court",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "maintenance_type",
   "fieldtype": "Select",
   "options": "Routine\nRepair\nDeep Clean\nEquipment Install\nOther",
   "label": "Maintenance Type",
   "in_list_view": 1
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "scheduled_date",
   "fieldtype": "Date",
   "label": "Scheduled Date",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "scheduled_start",
   "fieldtype": "Time",
   "label": "Start Time",
   "reqd": 1
  },
  {
   "fieldname": "scheduled_end",
   "fieldtype": "Time",
   "label": "End Time",
   "reqd": 1
  },
  {
   "fieldname": "section_break_1",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "assigned_to",
   "fieldtype": "Link",
   "options": "Employee",
   "label": "Assigned To"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "options": "Scheduled\nIn Progress\nCompleted\nCancelled",
   "default": "Scheduled",
   "label": "Status",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "notes",
   "fieldtype": "Small Text",
   "label": "Notes"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1, "write": 1, "create": 1, "delete": 1, "submit": 0
  },
  {
   "role": "Facility Manager",
   "read": 1, "write": 1, "create": 1
  }
 ]
}
