{
 "doctype": "DocType",
 "name": "Membership Renewal",
 "module": "Sports Complex",
 "custom": 0,
 "istable": 0,
 "issingle": 0,
 "is_submittable": 1,
 "editable_grid": 1,
 "engine": "InnoDB",
 "autoname": "naming_series:",
 "naming_rule": "By \"Naming Series\" field",
 "sort_field": "modified",
 "sort_order": "DESC",
 "track_changes": 1,
 "field_order": [
  "naming_series",
  "membership",
  "renewal_date",
  "column_break_1",
  "previous_end_date",
  "new_end_date",
  "amount",
  "sales_invoice",
  "amended_from"
 ],
 "fields": [
  {
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "options": "MSHIP-RNW-.YYYY.-",
   "label": "Series",
   "reqd": 1
  },
  {
   "fieldname": "membership",
   "fieldtype": "Link",
   "options": "Membership",
   "label": "Membership",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "renewal_date",
   "fieldtype": "Date",
   "label": "Renewal Date",
   "reqd": 1,
   "default": "Today",
   "in_list_view": 1
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "previous_end_date",
   "fieldtype": "Date",
   "label": "Previous End Date",
   "read_only": 1,
   "fetch_from": "membership.end_date"
  },
  {
   "fieldname": "new_end_date",
   "fieldtype": "Date",
   "label": "New End Date",
   "read_only": 1,
   "description": "Auto-calculated: Previous End Date + plan Duration"
  },
  {
   "fieldname": "amount",
   "fieldtype": "Currency",
   "label": "Amount",
   "reqd": 1
  },
  {
   "fieldname": "sales_invoice",
   "fieldtype": "Link",
   "options": "Sales Invoice",
   "label": "Sales Invoice",
   "read_only": 1,
   "no_copy": 1
  },
  {
   "fieldname": "amended_from",
   "fieldtype": "Link",
   "options": "Membership Renewal",
   "label": "Amended From",
   "read_only": 1,
   "no_copy": 1,
   "print_hide": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "print": 1,
   "email": 1,
   "export": 1,
   "share": 1,
   "report": 1
  },
  {
   "role": "Sports Complex Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "print": 1,
   "email": 1,
   "export": 1,
   "report": 1
  },
  {
   "role": "Sports Complex Staff",
   "read": 1,
   "write": 1,
   "create": 1,
   "submit": 1,
   "print": 1,
   "report": 1
  }
 ]
}
