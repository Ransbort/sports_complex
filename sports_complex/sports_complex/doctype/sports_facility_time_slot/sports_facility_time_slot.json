{
 "doctype": "DocType",
 "name": "Sports Facility Time Slot",
 "module": "Sports Complex",
 "custom": 0,
 "istable": 1,
 "issingle": 0,
 "is_submittable": 0,
 "track_changes": 1,
 "engine": "InnoDB",
 "editable_grid": 1,
