   "label": "Active",
   "default": "1",
   "in_list_view": 1,
   "columns": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "create": 1, "read": 1, "write": 1, "delete": 1, "email": 1, "export": 1, "print": 1, "report": 1, "share": 1
  },
  {
   "role": "Facility Manager",
   "create": 1, "read": 1, "write": 1, "email": 1, "export": 1, "print": 1, "report": 1, "share": 1
  }
 ],
