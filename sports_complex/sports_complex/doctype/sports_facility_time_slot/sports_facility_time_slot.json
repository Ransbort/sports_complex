   "reqd": 1,
   "in_list_view": 1,
   "columns": 2
  },
  {
   "fieldname": "slot_start",
   "fieldtype": "Time",
   "label": "Start Time",
   "reqd": 1,
   "in_list_view": 1,
   "columns": 2
  },
  {
   "fieldname": "slot_end",
   "fieldtype": "Time",
   "label": "End Time",
   "reqd": 1,
   "in_list_view": 1,
