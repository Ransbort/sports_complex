  },
  {
   "fieldname": "email",
   "fieldtype": "Data",
   "options": "Email",
   "label": "Email",
   "in_list_view": 1
  },
  {
   "fieldname": "phone",
   "fieldtype": "Data",
   "options": "Phone",
   "label": "Phone"
  },
  {
   "fieldname": "section_break_1",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "customer",
   "fieldtype": "Link",
   "options": "Customer",
   "label": "Customer",
   "unique": 1,
   "read_only": 1,
   "no_copy": 1,
