{
 "doctype": "DocType",
 "name": "Membership",
 "module": "Sports Complex",
 "custom": 0,
 "istable": 0,
 "issingle": 0,
 "is_submittable": 1,
 "editable_grid": 1,
 "engine": "InnoDB",
 "autoname": "naming_series:",
 "naming_rule": "By \"Naming Series\" field",
 "sort_field": "modified",
 "sort_order": "DESC",
 "track_changes": 1,
 "field_order": [
  "naming_series",
  "member",
  "membership_plan",
  "column_break_1",
  "start_date",
  "end_date",
  "status",
  "sales_invoice",
  "amended_from"
 ],
 "fields": [
  {
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "options": "MSHIP-.YYYY.-",
   "label": "Series",
   "reqd": 1
  },
  {
   "fieldname": "member",
   "fieldtype": "Link",
   "options": "Member",
   "label": "Member",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "membership_plan",
   "fieldtype": "Link",
   "options": "Membership Plan",
   "label": "Membership Plan",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "start_date",
   "fieldtype": "Date",
   "label": "Start Date",
   "reqd": 1,
   "default": "Today",
   "in_list_view": 1
  },
  {
   "fieldname": "end_date",
   "fieldtype": "Date",
   "label": "End Date",
   "read_only": 1,
   "in_list_view": 1,
   "description": "Auto-calculated from Start Date + plan Duration"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "options": "Active\nExpired\nSuspended\nCancelled",
   "default": "Active",
   "label": "Status",
   "read_only": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "sales_invoice",
   "fieldtype": "Link",
   "options": "Sales Invoice",
   "label": "Sales Invoice",
   "read_only": 1,
   "no_copy": 1
  },
  {
   "fieldname": "amended_from",
   "fieldtype": "Link",
   "options": "Membership",
   "label": "Amended From",
   "read_only": 1,
   "no_copy": 1,
   "print_hide": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1,
   "print": 1,
