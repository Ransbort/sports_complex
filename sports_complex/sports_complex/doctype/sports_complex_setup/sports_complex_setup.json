  {"fieldname": "column_break_pay_1", "fieldtype": "Column Break"},
  {"fieldname": "allow_partial_payment", "fieldtype": "Check", "label": "Allow Partial Payment", "default": "0"},
  {"fieldname": "refund_processing_days", "fieldtype": "Int", "label": "Refund Processing Time (days)", "default": "3"}
